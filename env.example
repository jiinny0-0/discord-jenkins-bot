# 원본은 C:\test-automation\bot-data\.env 에 둔다. start-bot.ps1이 실행 때 이 폴더의 .env로 복사한다.

JENKINS_URL=
JENKINS_JOB=
JENKINS_USER=
JENKINS_API_TOKEN=

DISCORD_BOT_TOKEN=
# 명령어를 등록할 Discord 서버 ID. 서버가 여러 개면 쉼표로 구분 (예: 111,222)
DISCORD_GUILD_ID=
BAT_RESULT_DIR=
# (선택) BAT reports 폴더. 단독 실행 기록이 없는 제품의 예상 시간을 run-report.json에서 계산
# 비우면 C:\test-automation\aioncloud-sse-bat\reports
BAT_REPORTS_DIR=

DISCORD_GUIDE_DOCS=
# /jenkins 명령어가 보여 줄 Jenkins 주소 (비우면 http://3.39.25.199:8080/)
JENKINS_LINK_URL=

# 선택 (비우면 기본값)
# BOT_DATA_DIR=C:\test-automation\bot-data
# BAT_EXCLUDE_FILE=C:\test-automation\bat-exclude.json
# ENVIRONMENTS_YAML=C:\test-automation\environments.yaml
# CONNECTOR_ALLOWED_USER_IDS=
# USASE_EXE=
# AICONNECTOR_EXE=
